"""Texas Instruments TPS61023DRLR synchronous boost converter."""

VIN = io(Power(voltage="0.5V - 5.5V"))
VOUT = io(Power(voltage="2.2V - 5.5V"))
GND = io(Ground)
SW = io(Power())
EN = io(Net("TPS61023_EN"))
FB = io(Net("TPS61023_FB"))

Component(
    name="U_TPS61023",
    prefix="U",
    description="TI TPS61023DRLR 0.5 V to 5.5 V, 3.7 A synchronous boost converter",
    symbol=Symbol(
        library="../assets/TPS61023DRL.kicad_sym",
        name="TPS61023DRL",
    ),
    footprint=File("../assets/Texas_R-PDSO-N6_DRL-6.kicad_mod"),
    part=Part(mpn="TPS61023DRLR", manufacturer="Texas Instruments"),
    datasheet="https://www.ti.com/lit/ds/symlink/tps61023.pdf",
    pins={
        "FB": FB,
        "EN": EN,
        "VIN": VIN,
        "GND": GND,
        "SW": SW,
        "VOUT": VOUT,
    },
    properties={
        "topology": "synchronous boost / step-up",
        "input_range": "0.5 V to 5.5 V",
        "output_range": "2.2 V to 5.5 V",
        "valley_current_limit": "3.7 A typical",
        "package": "DRL0006A SOT-563",
    },
)
