SW2 = io(Net("SW2"))
Component(
    name="SW_PTS841",
    prefix="SW",
    symbol=Symbol(library="PTS841.kicad_sym", name="PTS841"),
    footprint=File("PTS841GK.kicad_mod"),
    part=Part(mpn="PTS841GKSMTR LFS", manufacturer="C&K"),
    pins={"A": SW1, "B": SW2},
)