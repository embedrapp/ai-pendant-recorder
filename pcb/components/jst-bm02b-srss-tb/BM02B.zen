"""JST SH two-contact top-entry speaker connector; isolated mechanical tabs."""
PIN_1 = io(Net("PIN_1"))
PIN_2 = io(Net("PIN_2"))
MP1 = io(Net("MP1"), optional=True)
MP2 = io(Net("MP2"), optional=True)
Component(
    name="J_BM02B_ATTRIBUTED",
    prefix="J",
    symbol=Symbol(library="BM02B.kicad_sym", name="BM02B"),
    footprint=File("BM02B.kicad_mod"),
    part=Part(mpn="BM02B-SRSS-TB(LF)(SN)", manufacturer="JST"),
    pins={"Pin_1": PIN_1, "Pin_2": PIN_2, "MP1": MP1, "MP2": MP2},
)