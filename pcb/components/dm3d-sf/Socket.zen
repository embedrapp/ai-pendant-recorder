"""Hirose DM3D-SF microSD socket, SPI; card detection not used."""
VDD = io("VDD", Power)
GND = io("GND", Ground)
CLK = io("CLK", Net)
CS = io("CS", Net)
MOSI = io("MOSI", Net)
MISO = io("MISO", Net)
DAT1 = io("DAT1", Net)
DAT2 = io("DAT2", Net)
Component(name="SD", prefix="J",
    symbol=Symbol(library="DM3D-SF.kicad_sym", name="DM3D_SF"),
    footprint=File("DM3D-SF.kicad_mod"),
    part=Part(mpn="DM3D-SF", manufacturer="Hirose"),
    datasheet="https://www.hirose.com/en/product/series/DM3",
    pins={"DAT2": DAT2, "DAT3_CS": CS, "CMD_MOSI": MOSI, "VDD": VDD,
          "CLK": CLK, "VSS": GND, "DAT0_MISO": MISO, "DAT1": DAT1,
          "DETECT_A": NotConnected(), "DETECT_B": NotConnected(), "SHIELD": GND})