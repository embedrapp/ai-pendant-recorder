def sourced_passives(c):
    if not hasattr(c, "mpn"):
        return
    if c.mpn in PURCHASE_LINKS:
        c.properties["source_url"] = PURCHASE_LINKS[c.mpn]
        c.properties["note"] = "User-confirmed purchase link and in-stock status; no numeric stock or price provided."
    if c.mpn in DATASHEET_INDEX:
        c.properties["datasheet"] = "https://www.embedr.app/api/datasheets/" + DATASHEET_INDEX[c.mpn] + "/pdf"
    sources = {
        "RC0603FR-07100KL": ("YAGEO", "DigiKey", "311-100KHRCT-ND"),
        "PTS841GKSMTR LFS": ("C&K", "DigiKey", "108-PTS841GKSMTRLFSCT-ND"),
        "JS202011AQN": ("C&K", "DigiKey", "401-2000-ND"),
        "B2B-PH-K-S": ("J.S.T. Mfg. Co., Ltd.", "DigiKey", "455-1704-ND"),
    }
    if c.mpn in sources:
        mfr, supplier, sku = sources[c.mpn]
        c.part = Part(mpn=c.mpn, manufacturer=mfr)
        c.supplier = supplier
        c.supplier_part_number = sku
        c.properties["supplier"] = supplier
        c.properties["supplier_part_number"] = sku


Board(name="ai_pendant_recorder", layout_path="layout-base", layers=4, modifiers=[sourced_passives])

