# embedr:schematic-graphic {"id":"storage-section","type":"section","x":1750,"y":2050,"strokeWidth":1.5,"lineStyle":"solid","width":1650,"height":1500,"text":"06  CARRIER microSD / SPI","fontSize":28,"bold":true}
