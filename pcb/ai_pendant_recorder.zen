# embedr:schematic-graphic {"id":"led-row2","type":"section","x":5850,"y":1900,"strokeWidth":1.5,"lineStyle":"solid","width":3750,"height":750,"text":"03B / LED6–10  →  LED_CHAIN_10 to row 3","fontSize":26,"bold":true}
# embedr:schematic-graphic {"id":"led-row3","type":"section","x":5850,"y":2700,"strokeWidth":1.5,"lineStyle":"solid","width":3750,"height":750,"text":"03C / LED11–15  →  LED_CHAIN_15 to row 4","fontSize":26,"bold":true}
# embedr:schematic-graphic {"id":"led-row4","type":"section","x":5850,"y":3500,"strokeWidth":1.5,"lineStyle":"solid","width":3750,"height":750,"text":"03D / LED16–20  →  LED_CHAIN_20 to row 5","fontSize":26,"bold":true}
# embedr:schematic-graphic {"id":"led-row5","type":"section","x":5850,"y":4300,"strokeWidth":1.5,"lineStyle":"solid","width":3750,"height":750,"text":"03E / LED21–25  /  End of chain","fontSize":26,"bold":true}
"""Base-XIAO audio carrier schematic draft; see docs/current-design.md validation gates."""

Capacitor = Module("@stdlib/generics/Capacitor.zen")
Resistor = Module("@stdlib/generics/Resistor.zen")
XIAO = Module("./components/xiao-base/XIAO.zen")
Microphone = Module("./components/im69d130/Microphone.zen")
MicroSD = Module("./components/molex-104031-0811/Socket.zen")
B2B_PH_K_S = Module("./components/jst-b2b-ph-k-s/zener/B2B_PH_K_S.zen")
CK_JS202011AQN = Module("./components/ck-js202011aqn/zener/CK_JS202011AQN.zen")
PTS841GKSMTR = Module("./components/pts841gksmtr/PTS841.zen")
MountingHole = Module("@stdlib/generics/MountingHole.zen")
MAX17048 = Module("./components/max17048g-t10/MAX17048.zen")
TestPoint = Module("@stdlib/generics/TestPoint.zen")
BMI270 = Module("./components/bmi270/BMI270.zen")
MotorLDO = Module("./components/motor-ldo/LDO.zen")
Flyback = Module("./components/motor-diode/Diode.zen")
MOSFET_AO3400A_SOT23 = Module("./components/ao3400a/zener/MOSFET_AO3400A_SOT23.zen")
RGBPixel = Module("./components/ws2812c-2020-v1/LED.zen")
Boost = Module("./components/tps61023/zener/BOOST_CONVERTER_TPS61023_DRL.zen")
LoadSwitch = Module("./components/tps22918/zener/LOAD_SWITCH_TPS22918_DBV.zen")
BoostInductor = Module("./components/xel4030-102mec/Inductor.zen")
BusSwitch = Module("./components/sn74cbtlv3245a/BusSwitch.zen")

GND = Ground()
VBAT = Power(voltage="3.7V")
V3V3 = Power(voltage="3.3V")
V3V3_AON = Power(voltage="3.3V")
VBAT_PERIPH = Power(voltage="3.7V")
RUN_ENABLE = Net()
ISOLATE_N = Net()
PERIPH_RISE = Net()
BAT_RISE = Net()
HOST_SDA = Net()
HOST_SCL = Net()
HOST_PDM_CLK = Net()
HOST_PDM_DATA = Net()
HOST_SD_CLK = Net()
HOST_SD_CS = Net()
HOST_SD_MOSI = Net()
HOST_SD_MISO = Net()
HOST_IMU_INT = Net()
HOST_LED_ENABLE = Net()
HOST_LED_DATA = Net()
HOST_HAPTIC = Net()
MCU_EN = Net()
RECORD_BUTTON = Net()
FG_SDA = Net()
FG_SCL = Net()
HAPTIC_DRIVE = Net()
MOTOR_GATE = Net()
MOTOR_N = Net()
MOTOR_3V3 = Power(voltage="3.3V")
PDM_CLK_MCU = Net()
PDM_CLK = Net()
PDM_DATA = Net()
SD_CLK_MCU = Net()
SD_CLK = Net()
SD_CS = Net()
SD_MOSI = Net()
SD_MISO = Net()
SD_DAT1 = Net()
SD_DAT2 = Net()
IMU_INT = Net()
LED_ENABLE = Net()
LED_DATA_MCU = Net()
LED_DATA = Net()
BOOST_5V = Power(voltage="5V")
LED_5V = Power(voltage="5V")
LED_SW = Power()
LED_FB = Net()
LED_RISE = Net()

XIAO(
    name="U1",
    GND=GND,
    VBAT=VBAT,
    V3V3=V3V3_AON,
    D0=HOST_HAPTIC,
    D1=RECORD_BUTTON,
    D2=HOST_LED_ENABLE,
    D3=HOST_LED_DATA,
    D4_SDA=HOST_SDA,
    D5_SCL=HOST_SCL,
    EN=MCU_EN,
    D8_SCK=HOST_SD_CLK,
    D9_MISO=HOST_SD_MISO,
    D10_MOSI=HOST_SD_MOSI,
    MTCK=HOST_SD_CS,
    MTDO=HOST_IMU_INT,
    MTDI=HOST_PDM_DATA,
    MTMS=HOST_PDM_CLK,
)

# Hardware standby: J1 VBAT remains directly connected to XIAO and fuel gauge.
# U9 gates only the boost/motor branch, NOT the battery-to-charger connection.
# Both peripheral input rails are switched; bus switches isolate GPIO in standby.
# SW2 pole 2: low=standby, high=run; R29 defines the break-before-make state.
LoadSwitch(name="U8", VIN=V3V3_AON, VOUT=V3V3, GND=GND, ON=RUN_ENABLE, CT=PERIPH_RISE, QOD=V3V3)
LoadSwitch(name="U9", VIN=VBAT, VOUT=VBAT_PERIPH, GND=GND, ON=RUN_ENABLE, CT=BAT_RISE, QOD=VBAT_PERIPH)
for ref, rail in [("C41", PERIPH_RISE), ("C42", BAT_RISE)]:
    Capacitor(name=ref, value="1nF", package="0402", voltage="25V", dielectric="C0G", mpn="GRM1555C1E102JA01D", manufacturer="Murata", P1=rail, P2=GND)
for ref, rail in [("C43", V3V3_AON), ("C44", VBAT)]:
    Capacitor(name=ref, value="10uF", package="0805", voltage="25V", dielectric="X5R", mpn="CC0805KRX5R8BB106", manufacturer="YAGEO", P1=rail, P2=GND)
Resistor(name="R29", value="100kohm", package="0603", power="100mW", mpn="RC0603FR-07100KL", manufacturer="YAGEO", P1=RUN_ENABLE, P2=GND)
# Q2 inverts RUN_ENABLE. Isolation ICs use switched VCC and Ioff protection.
MOSFET_AO3400A_SOT23(name="Q2", G=RUN_ENABLE, S=GND, D=ISOLATE_N)
Resistor(name="R30", value="4.7kohm", package="0603", power="100mW", mpn="RC0603FR-074K7L", manufacturer="YAGEO", P1=ISOLATE_N, P2=V3V3)
BusSwitch(name="U10", VCC=V3V3, GND=GND, OE_N=ISOLATE_N,
    A1=HOST_SD_CLK, B1=SD_CLK_MCU, A2=HOST_SD_CS, B2=SD_CS,
    A3=HOST_SD_MOSI, B3=SD_MOSI, A4=HOST_SD_MISO, B4=SD_MISO,
    A5=HOST_PDM_CLK, B5=PDM_CLK_MCU, A6=HOST_PDM_DATA, B6=PDM_DATA,
    A7=HOST_SDA, B7=FG_SDA, A8=HOST_SCL, B8=FG_SCL)
BusSwitch(name="U11", VCC=V3V3, GND=GND, OE_N=ISOLATE_N,
    A1=HOST_IMU_INT, B1=IMU_INT, A2=HOST_LED_ENABLE, B2=LED_ENABLE,
    A3=HOST_LED_DATA, B3=LED_DATA_MCU, A4=HOST_HAPTIC, B4=HAPTIC_DRIVE,
    A5=GND, B5=NotConnected(), A6=GND, B6=NotConnected(),
    A7=GND, B7=NotConnected(), A8=GND, B8=NotConnected())
for ref in ["C45", "C46"]:
    Capacitor(name=ref, value="100nF", package="0402", voltage="16V", dielectric="X7R", mpn="GRM155R71C104KA88D", manufacturer="Murata", P1=V3V3, P2=GND)

# 5x5 central addressable RGB matrix. Worldsemi WS2812C-2020-V1 is the
# low-current 5 mA/channel variant, powered from a switched 5 V boost rail.
# Datasheet: 3.7-5.3 V supply, VIH >=2.7 V, 100 nF local bypass per pixel.
# Firmware must keep LED_ENABLE low at reset, drive LED_DATA low before enable,
# globally cap brightness, and never run full-white LEDs with the vibration motor.
Boost(name="U5", VIN=VBAT_PERIPH, VOUT=BOOST_5V, GND=GND, SW=LED_SW, EN=LED_ENABLE, FB=LED_FB)
BoostInductor(name="L1", P1=VBAT_PERIPH, P2=LED_SW)
Resistor(
    name="R25",
    value="732kohm",
    package="0603",
    power="100mW",
    mpn="RC0603FR-07732KL",
    manufacturer="YAGEO",
    P1=BOOST_5V,
    P2=LED_FB,
)
Resistor(
    name="R26",
    value="100kohm",
    package="0603",
    power="100mW",
    mpn="RC0603FR-07100KL",
    manufacturer="YAGEO",
    P1=LED_FB,
    P2=GND,
)
Resistor(
    name="R27",
    value="100kohm",
    package="0603",
    power="100mW",
    mpn="RC0603FR-07100KL",
    manufacturer="YAGEO",
    P1=LED_ENABLE,
    P2=GND,
)
Resistor(
    name="R28",
    value="470ohm",
    package="0603",
    power="100mW",
    mpn="RC0603FR-07470RL",
    manufacturer="YAGEO",
    P1=LED_DATA_MCU,
    P2=LED_DATA,
)
Capacitor(
    name="C12",
    value="10uF",
    package="0805",
    voltage="25V",
    dielectric="X5R",
    mpn="CC0805KRX5R8BB106",
    manufacturer="YAGEO",
    P1=VBAT_PERIPH,
    P2=GND,
)
for ref in ["C13", "C14"]:
    Capacitor(
        name=ref,
        value="22uF",
        package="0805",
        voltage="10V",
        dielectric="X5R",
        mpn="GRM21BR61A226ME44L",
        manufacturer="Murata",
        P1=BOOST_5V,
        P2=GND,
    )
# U7 adds a positively controlled rail boundary after the boost. Both U5 EN and
# U7 ON use LED_ENABLE, which is held low at reset. C40 gives about 2.9 ms
# nominal 10%-90% rise at 5 V (TPS22918 SR = 0.55*CT[pF]+30 us/V).
# QOD is tied directly to the switched output for defined discharge when off.
LoadSwitch(name="U7", VIN=BOOST_5V, VOUT=LED_5V, GND=GND, ON=LED_ENABLE, CT=LED_RISE, QOD=LED_5V)
Capacitor(
    name="C40",
    value="1nF",
    package="0402",
    voltage="25V",
    dielectric="C0G",
    mpn="GRM1555C1E102JA01D",
    manufacturer="Murata",
    P1=LED_RISE,
    P2=GND,
)
pixel_chain = [Net("LED_CHAIN_" + str(i + 1)) for i in range(24)]
pixel_data = LED_DATA
for pixel in range(25):
    next_data = pixel_chain[pixel] if pixel < 24 else NotConnected()
    RGBPixel(name="LED" + str(pixel + 1), DI=pixel_data, DO=next_data, VDD=LED_5V, GND=GND)
    Capacitor(
        name="C" + str(15 + pixel),
        value="100nF",
        package="0402",
        voltage="16V",
        dielectric="X7R",
        mpn="GRM155R71C104KA88D",
        manufacturer="Murata",
        P1=LED_5V,
        P2=GND,
    )
    pixel_data = next_data

# Shared 3.3 V I2C bus. MAX17048 address 0x36; polling, ALRT unconnected.
# R6 omitted (DNP option). CELL tied to BAT+ per datasheet pin table p6,
# despite being internally unconnected on MAX17048.
MAX17048(name="U3", VBAT=VBAT, GND=GND, SDA=FG_SDA, SCL=FG_SCL)
Capacitor(
    name="C3",
    value="100nF",
    package="0603",
    voltage="50V",
    dielectric="X7R",
    mpn="GCM188R71H104KA57J",
    manufacturer="Murata",
    P1=VBAT,
    P2=GND,
)
Resistor(
    name="R4",
    value="4.7kohm",
    package="0603",
    power="100mW",
    mpn="RC0603FR-074K7L",
    manufacturer="YAGEO",
    P1=FG_SDA,
    P2=V3V3,
)
Resistor(
    name="R5",
    value="4.7kohm",
    package="0603",
    power="100mW",
    mpn="RC0603FR-074K7L",
    manufacturer="YAGEO",
    P1=FG_SCL,
    P2=V3V3,
)
TestPoint(name="TP3", variant="Pad_D1.0mm", P1=FG_SDA)
TestPoint(name="TP4", variant="Pad_D1.0mm", P1=FG_SCL)

# BMI270 I2C 0x68. Configure active-high push-pull INT1 for software-sleep wake.
BMI270(name="U4", VDD=V3V3, GND=GND, SDA=FG_SDA, SCL=FG_SCL, INT1=IMU_INT)
Capacitor(
    name="C4",
    value="100nF",
    package="0603",
    voltage="50V",
    dielectric="X7R",
    mpn="GCM188R71H104KA57J",
    manufacturer="Murata",
    P1=V3V3,
    P2=GND,
)
Capacitor(
    name="C5",
    value="100nF",
    package="0603",
    voltage="50V",
    dielectric="X7R",
    mpn="GCM188R71H104KA57J",
    manufacturer="Murata",
    P1=V3V3,
    P2=GND,
)

# PCA9685 and external RGB removed. Use XIAO onboard GPIO21 status LED.
# U6 is supplied only in RUN; D0 independently controls Q1.
MotorLDO(name="U6", VIN=VBAT_PERIPH, VOUT=MOTOR_3V3, GND=GND, EN=VBAT_PERIPH)
for ref, rail in [("C7", VBAT_PERIPH), ("C8", MOTOR_3V3)]:
    Capacitor(
        name=ref,
        value="10uF",
        package="0805",
        voltage="25V",
        dielectric="X5R",
        mpn="CC0805KRX5R8BB106",
        manufacturer="YAGEO",
        P1=rail,
        P2=GND,
    )
Resistor(
    name="R7",
    value="100ohm",
    package="0603",
    power="100mW",
    mpn="RC0603FR-07100RL",
    manufacturer="YAGEO",
    P1=HAPTIC_DRIVE,
    P2=MOTOR_GATE,
)
Resistor(
    name="R8",
    value="100kohm",
    package="0603",
    power="100mW",
    mpn="RC0603FR-07100KL",
    manufacturer="YAGEO",
    P1=MOTOR_GATE,
    P2=GND,
)
MOSFET_AO3400A_SOT23(name="Q1", G=MOTOR_GATE, S=GND, D=MOTOR_N)
Flyback(name="D1", K=MOTOR_3V3, A=MOTOR_N)
B2B_PH_K_S(name="J3", PIN_1=MOTOR_3V3, PIN_2=MOTOR_N)

# Standalone PDM capture and SPI storage. No Sense expansion or camera circuits.
# J4 is the active Molex 104031-0811 push-pull socket; its detect switch is unused.
# IM69D130 datasheet: 1.62-3.6 V; SELECT low selects one PDM edge/channel.
# C9 is the required local 100 nF VDD bypass. R23 holds CLOCK low for the
# datasheet's clock-off mode. A ~100 ohm DATA termination is optional and must
# be decided from the eventual trace length/ringing; do not add it blindly.
Microphone(name="MK1", VDD=V3V3, GND=GND, CLOCK=PDM_CLK, DATA=PDM_DATA)
MicroSD(name="J4", VDD=V3V3, GND=GND, CLK=SD_CLK, CS=SD_CS, MOSI=SD_MOSI, MISO=SD_MISO, DAT1=SD_DAT1, DAT2=SD_DAT2)
for ref in ["C9", "C10"]:
    Capacitor(
        name=ref,
        value="100nF",
        package="0603",
        voltage="50V",
        dielectric="X7R",
        mpn="GCM188R71H104KA57J",
        manufacturer="Murata",
        P1=V3V3,
        P2=GND,
    )
Capacitor(
    name="C11",
    value="10uF",
    package="0805",
    voltage="25V",
    dielectric="X5R",
    mpn="CC0805KRX5R8BB106",
    manufacturer="YAGEO",
    P1=V3V3,
    P2=GND,
)
for ref, a, b in [("R16", PDM_CLK_MCU, PDM_CLK), ("R17", SD_CLK_MCU, SD_CLK)]:
    Resistor(
        name=ref, value="33ohm", package="0603", power="100mW", mpn="RC0603FR-0733RL", manufacturer="YAGEO", P1=a, P2=b
    )
for ref, signal in [("R18", SD_CS), ("R19", SD_MOSI), ("R20", SD_MISO), ("R21", SD_DAT1), ("R22", SD_DAT2)]:
    Resistor(
        name=ref,
        value="47kohm",
        package="0603",
        power="100mW",
        mpn="RC0603FR-0747KL",
        manufacturer="YAGEO",
        P1=signal,
        P2=V3V3,
    )
Resistor(
    name="R23",
    value="100kohm",
    package="0603",
    power="100mW",
    mpn="RC0603FR-07100KL",
    manufacturer="YAGEO",
    P1=PDM_CLK,
    P2=GND,
)

# C1/C2: exact MPNs from docs/bom.md and retained manufacturer datasheets.
# R1: DigiKey 311-100KHRCT-ND.
# These are supplier identities, not a live stock or price guarantee.
Capacitor(
    name="C1",
    value="100nF",
    package="0603",
    voltage="50V",
    dielectric="X7R",
    mpn="GCM188R71H104KA57J",
    manufacturer="Murata",
    P1=VBAT,
    P2=GND,
)
Capacitor(
    name="C2",
    value="10uF",
    package="0805",
    voltage="25V",
    dielectric="X5R",
    mpn="CC0805KRX5R8BB106",
    manufacturer="YAGEO",
    P1=VBAT,
    P2=GND,
)
Resistor(
    name="R1",
    value="100kohm",
    package="0603",
    power="100mW",
    mpn="RC0603FR-07100KL",
    manufacturer="YAGEO",
    P1=RECORD_BUTTON,
    P2=V3V3_AON,
)

# Harness polarity is explicit, not implied by JST housing shape.
B2B_PH_K_S(name="J1", PIN_1=VBAT, PIN_2=GND)
PTS841GKSMTR(name="SW1", SW1=RECORD_BUTTON, SW2=GND)
# STANDBY: poles 1-2 and 4-5 close. RUN: 2-3 and 5-6 close.
# Only control current traverses contacts. XIAO internal charging is unchanged.
CK_JS202011AQN(name="SW2", POLE1_COMMON=MCU_EN, POLE1_THROW_A=GND,
    POLE2_COMMON=RUN_ENABLE, POLE2_THROW_A=GND, POLE2_THROW_B=V3V3_AON)
for i in range(4):
    MountingHole(name="H" + str(i + 1), diameter="M2", plating="Mechanical")


PURCHASE_LINKS = {
    "GCM188R71H104KA57J": "https://www.digikey.in/en/products/detail/murata-electronics/GCM188R71H104KA57J/4380305",
    "CC0805KRX5R8BB106": "https://www.mouser.in/en/ProductDetail/YAGEO/CC0805KRX5R8BB106?qs=CNuWj9FTWYDQ%252BJODP2bXGA%3D%3D",
    "NSVR0320MW2T1G": "https://in.element14.com/on-semiconductor/nsvr0320mw2t1g/schottky-diode-20v-sod-323/dp/2533249",
    "B2B-PH-K-S": "https://www.digikey.in/en/products/detail/jst-sales-america-inc/B2B-PH-K-S/926611",
    "104031-0811": "https://www.mouser.in/en/ProductDetail/Molex/104031-0811?qs=udsGRKD4nA3Tvy7wqky%252BuA%3D%3D",
    "AO3400A": "https://www.digikey.in/en/products/detail/alpha-omega-semiconductor-inc/AO3400A/1855772",
    "RC0603FR-07100KL": "https://www.digikey.in/en/products/detail/yageo/RC0603FR-07100KL/726889",
    "RC0603FR-074K7L": "https://www.digikey.in/en/products/detail/yageo/RC0603FR-074K7L/727212",
    "RC0603FR-07100RL": "https://www.digikey.in/en/products/detail/yageo/RC0603FR-07100RL/726888",
    "JS202011AQN": "https://www.digikey.in/en/products/detail/c-k/JS202011AQN/1640096",
    "113991114": "https://www.seeedstudio.com/XIAO-ESP32S3-p-5627.html",
