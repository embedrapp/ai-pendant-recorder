# embedr:schematic-graphic {"id":"revision-warning","type":"note","x":0,"y":3650,"strokeWidth":1.5,"lineStyle":"solid","width":5500,"height":200,"text":"BASE XIAO 113991114 • NO SENSE / CAMERA / PCA9685 / EXTERNAL RGB. SCHEMATIC DRAFT: microphone and footprint review open. Old routed board is NOT this revision. See docs/base-redesign.md.","fontSize":23,"bold":false}
"""Base-XIAO audio carrier schematic draft; see docs/base-redesign.md validation gates."""

Capacitor = Module("@stdlib/generics/Capacitor.zen")
Resistor = Module("@stdlib/generics/Resistor.zen")
XIAO = Module("./components/xiao-base/XIAO.zen")
Microphone = Module("./components/im69d130/Microphone.zen")
MicroSD = Module("./components/dm3d-sf/Socket.zen")
MAX98357A = Module("./components/max98357aete-t/zener/MAX98357A.zen")
B2B_PH_K_S = Module("./components/jst-b2b-ph-k-s/zener/B2B_PH_K_S.zen")
BM02B = Module("./components/jst-bm02b-srss-tb/BM02B.zen")
CK_JS202011AQN = Module("./components/ck-js202011aqn/zener/CK_JS202011AQN.zen")
PTS841GKSMTR = Module("./components/pts841gksmtr/PTS841.zen")
MountingHole = Module("@stdlib/generics/MountingHole.zen")
MAX17048 = Module("./components/max17048g-t10/MAX17048.zen")
TestPoint = Module("@stdlib/generics/TestPoint.zen")
BMI270 = Module("./components/bmi270/BMI270.zen")
MotorLDO = Module("./components/motor-ldo/LDO.zen")
Flyback = Module("./components/motor-diode/Diode.zen")
MOSFET_AO3400A_SOT23 = Module("./components/ao3400a/zener/MOSFET_AO3400A_SOT23.zen")

GND = Ground()
VBAT = Power(voltage="3.7V")
V3V3 = Power(voltage="3.3V")
I2S_BCLK = Net()
I2S_LRCLK = Net()
I2S_DIN = Net()
AMP_SD = Net()
AMP_ENABLE = Net()
AMP_GAIN = Net()
MCU_EN = Net()
SPK_P = Net()
SPK_N = Net()
RECORD_BUTTON = Net()
FG_SDA = Net()
FG_SCL = Net()
HAPTIC_ARM = Net()
MOTOR_GATE = Net()
MOTOR_N = Net()
MOTOR_3V3 = Power(voltage="3.3V")
PDM_CLK_MCU = Net()
PDM_CLK = Net()
PDM_DATA = Net()
SD_CLK_MCU = Net()
SD_CLK = Net()
SD_CS = Net()
SD_MOSI = Net()
SD_MISO = Net()
SD_DAT1 = Net()
SD_DAT2 = Net()
IMU_INT = Net()

XIAO(name="U1", GND=GND, VBAT=VBAT, V3V3=V3V3,
    D0=HAPTIC_ARM, D1=RECORD_BUTTON, D6_TX=I2S_LRCLK, D7_RX=I2S_DIN,
    D3=I2S_BCLK, D2=AMP_ENABLE, D4_SDA=FG_SDA, D5_SCL=FG_SCL, EN=MCU_EN,
    D8_SCK=SD_CLK_MCU, D9_MISO=SD_MISO, D10_MOSI=SD_MOSI,
    MTCK=SD_CS, MTDO=IMU_INT, MTDI=PDM_DATA, MTMS=PDM_CLK_MCU)
MAX98357A(name="U2", VDD=VBAT, GND=GND, DIN=I2S_DIN,
    BCLK=I2S_BCLK, LRCLK=I2S_LRCLK, SD_MODE=AMP_SD,
    OUTP=SPK_P, OUTN=SPK_N, PAD=GND, GAIN_SLOT=AMP_GAIN)
# Datasheet p5: 100k to VDD selects 3 dB, avoiding floating 9 dB default.
Resistor(name="R24", value="100kohm", package="0603", power="100mW",
    mpn="RC0603FR-07100KL", manufacturer="YAGEO", P1=AMP_GAIN, P2=VBAT)

# Shared 3.3 V I2C bus. MAX17048 address 0x36; polling, ALRT unconnected.
# R6 omitted (DNP option). CELL tied to BAT+ per datasheet pin table p6,
# despite being internally unconnected on MAX17048.
MAX17048(name="U3", VBAT=VBAT, GND=GND, SDA=FG_SDA, SCL=FG_SCL)
Capacitor(name="C3", value="100nF", package="0603", voltage="50V", dielectric="X7R",
    mpn="GCM188R71H104KA57J", manufacturer="Murata", P1=VBAT, P2=GND)
Resistor(name="R4", value="4.7kohm", package="0603", power="100mW",
    mpn="RC0603FR-074K7L", manufacturer="YAGEO", P1=FG_SDA, P2=V3V3)
Resistor(name="R5", value="4.7kohm", package="0603", power="100mW",
    mpn="RC0603FR-074K7L", manufacturer="YAGEO", P1=FG_SCL, P2=V3V3)
TestPoint(name="TP3", variant="Pad_D1.0mm", P1=FG_SDA)
TestPoint(name="TP4", variant="Pad_D1.0mm", P1=FG_SCL)

# BMI270 I2C 0x68. Configure active-high push-pull INT1 for software-sleep wake.
BMI270(name="U4", VDD=V3V3, GND=GND, SDA=FG_SDA, SCL=FG_SCL, INT1=IMU_INT)
Capacitor(name="C4", value="100nF", package="0603", voltage="50V", dielectric="X7R",
    mpn="GCM188R71H104KA57J", manufacturer="Murata", P1=V3V3, P2=GND)
Capacitor(name="C5", value="100nF", package="0603", voltage="50V", dielectric="X7R",
    mpn="GCM188R71H104KA57J", manufacturer="Murata", P1=V3V3, P2=GND)

# PCA9685 and external RGB removed. Use XIAO onboard GPIO21 status LED.
# D0 gates BOTH motor rail and MOSFET; use timed on/off events, not LDO PWM.
MotorLDO(name="U6", VIN=VBAT, VOUT=MOTOR_3V3, GND=GND, EN=HAPTIC_ARM)
Resistor(name="R15", value="100kohm", package="0603", power="100mW",
    mpn="RC0603FR-07100KL", manufacturer="YAGEO", P1=HAPTIC_ARM, P2=GND)
for ref, rail in [("C7", VBAT), ("C8", MOTOR_3V3)]:
    Capacitor(name=ref, value="10uF", package="0805", voltage="25V", dielectric="X5R",
        mpn="CC0805KRX5R8BB106", manufacturer="YAGEO", P1=rail, P2=GND)
Resistor(name="R7", value="100ohm", package="0603", power="100mW",
    mpn="RC0603FR-07100RL", manufacturer="YAGEO", P1=HAPTIC_ARM, P2=MOTOR_GATE)
Resistor(name="R8", value="100kohm", package="0603", power="100mW",
    mpn="RC0603FR-07100KL", manufacturer="YAGEO", P1=MOTOR_GATE, P2=GND)
MOSFET_AO3400A_SOT23(name="Q1", G=MOTOR_GATE, S=GND, D=MOTOR_N)
Flyback(name="D1", K=MOTOR_3V3, A=MOTOR_N)
B2B_PH_K_S(name="J3", PIN_1=MOTOR_3V3, PIN_2=MOTOR_N)

# Standalone PDM capture and SPI storage. No Sense expansion or camera circuits.
Microphone(name="MK1", VDD=V3V3, GND=GND, CLOCK=PDM_CLK, DATA=PDM_DATA)
MicroSD(name="J4", VDD=V3V3, GND=GND, CLK=SD_CLK, CS=SD_CS,
    MOSI=SD_MOSI, MISO=SD_MISO, DAT1=SD_DAT1, DAT2=SD_DAT2)
for ref in ["C9", "C10"]:
    Capacitor(name=ref, value="100nF", package="0603", voltage="50V", dielectric="X7R",
        mpn="GCM188R71H104KA57J", manufacturer="Murata", P1=V3V3, P2=GND)
Capacitor(name="C11", value="10uF", package="0805", voltage="25V", dielectric="X5R",
    mpn="CC0805KRX5R8BB106", manufacturer="YAGEO", P1=V3V3, P2=GND)
for ref, a, b in [("R16", PDM_CLK_MCU, PDM_CLK), ("R17", SD_CLK_MCU, SD_CLK)]:
    Resistor(name=ref, value="33ohm", package="0603", power="100mW",
        mpn="RC0603FR-0733RL", manufacturer="YAGEO", P1=a, P2=b)
for ref, signal in [("R18", SD_CS), ("R19", SD_MOSI), ("R20", SD_MISO),
                    ("R21", SD_DAT1), ("R22", SD_DAT2)]:
    Resistor(name=ref, value="47kohm", package="0603", power="100mW",
        mpn="RC0603FR-0747KL", manufacturer="YAGEO", P1=signal, P2=V3V3)
Resistor(name="R23", value="100kohm", package="0603", power="100mW",
    mpn="RC0603FR-07100KL", manufacturer="YAGEO", P1=PDM_CLK, P2=GND)

# C1/C2: exact MPNs from docs/bom.md and retained manufacturer datasheets.
# R1/R2: DigiKey 311-100KHRCT-ND; R3: 311-2.00KHRCT-ND.
# These are supplier identities, not a live stock or price guarantee.
Capacitor(name="C1", value="100nF", package="0603", voltage="50V", dielectric="X7R",
    mpn="GCM188R71H104KA57J", manufacturer="Murata", P1=VBAT, P2=GND)
Capacitor(name="C2", value="10uF", package="0805", voltage="25V", dielectric="X5R",
    mpn="CC0805KRX5R8BB106", manufacturer="YAGEO", P1=VBAT, P2=GND)
Resistor(name="R1", value="100kohm", package="0603", power="100mW",
    mpn="RC0603FR-07100KL", manufacturer="YAGEO", P1=RECORD_BUTTON, P2=V3V3)
Resistor(name="R2", value="100kohm", package="0603", power="100mW",
    mpn="RC0603FR-07100KL", manufacturer="YAGEO", P1=AMP_SD, P2=GND)
Resistor(name="R3", value="2kohm", package="0603", power="100mW",
    mpn="RC0603FR-072KL", manufacturer="YAGEO", P1=AMP_ENABLE, P2=AMP_SD)

# Harness polarity is explicit, not implied by JST housing shape.
B2B_PH_K_S(name="J1", PIN_1=VBAT, PIN_2=GND)
BM02B(name="J2", PIN_1=SPK_P, PIN_2=SPK_N)
PTS841GKSMTR(name="SW1", SW1=RECORD_BUTTON, SW2=GND)
# Standby switch only: OFF grounds reset and amplifier shutdown. It does NOT
# disconnect the cell/charger. Do not route full load through 0.3 A contacts.
CK_JS202011AQN(name="SW2", POLE1_COMMON=MCU_EN, POLE1_THROW_A=GND,
    POLE2_COMMON=AMP_SD, POLE2_THROW_A=GND)
for i in range(4):
    MountingHole(name="H" + str(i + 1), diameter="M2", plating="Mechanical")

def sourced_passives(c):
    if not hasattr(c, "mpn"):
        return
    sources = {
        "RC0603FR-07100KL": ("YAGEO", "DigiKey", "311-100KHRCT-ND"),
        "RC0603FR-072KL": ("YAGEO", "DigiKey", "311-2.00KHRCT-ND"),
        "PTS841GKSMTR LFS": ("C&K", "DigiKey", "108-PTS841GKSMTRLFSCT-ND"),
        "JS202011AQN": ("C&K", "DigiKey", "401-2000-ND"),
        "B2B-PH-K-S": ("J.S.T. Mfg. Co., Ltd.", "DigiKey", "455-1704-ND"),
        "BM02B-SRSS-TB(LF)(SN)": ("JST", "DigiKey", "455-1788-1-ND"),
    }
    if c.mpn in sources:
        mfr, supplier, sku = sources[c.mpn]
        c.part = Part(mpn=c.mpn, manufacturer=mfr)
        c.supplier = supplier
        c.supplier_part_number = sku
        c.properties["supplier"] = supplier
        c.properties["supplier_part_number"] = sku

Board(name="ai_pendant_recorder", layout_path="layout-base", layers=2, modifiers=[sourced_passives])

